# systemd *user* service. Install to ~/.config/systemd/user/pdrive.service, then:
#   systemctl --user enable --now pdrive && loginctl enable-linger "$USER"
[Unit]
Description=PersonalDrive home server
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/pdrive serve --log-json
Restart=on-failure
RestartSec=5
# Thumbnailing and hashing are background work; keep the desktop responsive.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
