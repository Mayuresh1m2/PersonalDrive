{
  "name": "@pdrive/client",
  "version": "0.1.0",
  "description": "TypeScript client for the PersonalDrive home server: auth, resumable uploads, sync feed",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "api"],
  "scripts": {
    "generate": "openapi-typescript api/openapi.yaml -o src/schema.d.ts",
    "build": "tsc -p tsconfig.build.json && cp src/schema.d.ts dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
